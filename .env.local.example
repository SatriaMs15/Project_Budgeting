# Copy this file to `.env.local` and fill in your values.
# The same vars must also be set in Vercel -> Project -> Settings -> Environment Variables.

# Supabase dashboard -> Project Settings -> API
# NEXT_PUBLIC_ vars are safe to expose to the browser (the anon key is meant to be public;
# Row Level Security is what actually protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables AI extraction on the /import page (Google AI Studio -> API keys).
# Without it, import still works for CSV files via the deterministic parser.
GEMINI_API_KEY=your-gemini-api-key
